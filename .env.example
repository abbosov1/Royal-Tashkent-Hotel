# Copy this file to .env and fill with real credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hotel_db
DATABASE_URL=postgresql://postgres:change_me@db:5432/hotel_db
SECRET_KEY=replace_with_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Royal Tashkent <your_email@gmail.com>
SMTP_USE_TLS=true
# For serverless platforms (e.g. Vercel), set true to send emails before response returns.
EMAIL_INLINE_SEND=true

# Contact form delivery mode: db | email | webhook | db+email | db+webhook | email+webhook | all
CONTACT_DELIVERY=db+email
# Optional destination email for contact messages (defaults to ADMIN_EMAIL/SMTP_USER)
CONTACT_EMAIL_TO=admin@example.com
# Optional webhook URL (Telegram bot endpoint, Slack incoming webhook, custom API)
CONTACT_WEBHOOK_URL=
